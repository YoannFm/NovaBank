<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.novadev.novabank</groupId>
        <artifactId>novabank-parent</artifactId>
        <version>2026.11.23 (1.0.0 #1)</version>
    </parent>

    <artifactId>novabank-storage-file</artifactId>
    <name>NovaBank Storage File</name>
    <description>Stockage fichier des banques (YAML, JSON), mono-serveur (D4) : etat en memoire, journal
        d'ecriture append-only synchronise a chaque operation, instantane compacte au format choisi.</description>

    <properties>
        <!-- Valeur par defaut, completee par l'agent JaCoCo (prepare-agent). -->
        <argLine></argLine>
        <compat.libs>${project.build.directory}/compat-libs</compat.libs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.novadev.novabank</groupId>
            <artifactId>novabank-core</artifactId>
        </dependency>
        <!-- Fournies par le serveur (Bukkit les embarque), jamais dans le jar du plugin. Compilation
             contre les versions du serveur le plus ancien (1.17.1) ; tests aussi contre les recentes. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml-bukkit.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>dev.novadev.novabank</groupId>
            <artifactId>novabank-core</artifactId>
            <type>test-jar</type>
        </dependency>
        <!-- Migrations SQLite <-> YAML/JSON (tests). -->
        <dependency>
            <groupId>dev.novadev.novabank</groupId>
            <artifactId>novabank-storage-sql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- SnakeYAML 2.x et Gson recent pour la seconde execution des tests (serveurs recents). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bibliotheques-serveurs-recents</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${compat.libs}</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.yaml</groupId>
                                    <artifactId>snakeyaml</artifactId>
                                    <version>${snakeyaml-recent.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.google.code.gson</groupId>
                                    <artifactId>gson</artifactId>
                                    <version>${gson-recent.version}</version>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Pilote SQLite de test (bibliotheque native) : acces natif autorise pour le JDK 25. -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <novabank.test.expected-snakeyaml>${snakeyaml-bukkit.version}</novabank.test.expected-snakeyaml>
                        <novabank.test.expected-gson>${gson-bukkit.version}</novabank.test.expected-gson>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <!-- Execution par defaut : SnakeYAML 1.28 et Gson 2.8.0 (Spigot/Paper 1.17.1). -->
                        <id>default-test</id>
                    </execution>
                    <execution>
                        <!-- Formats et stockage complet avec SnakeYAML 2.x et Gson recent (1.18+, 26.x). -->
                        <id>serveurs-recents</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*CodecTest.java</include>
                                <include>**/FileStorageContractTests.java</include>
                            </includes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>org.yaml:snakeyaml</classpathDependencyExclude>
                                <classpathDependencyExclude>com.google.code.gson:gson</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${compat.libs}/snakeyaml-${snakeyaml-recent.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${compat.libs}/gson-${gson-recent.version}.jar</additionalClasspathElement>
                            </additionalClasspathElements>
                            <systemPropertyVariables>
                                <novabank.test.expected-snakeyaml>${snakeyaml-recent.version}</novabank.test.expected-snakeyaml>
                                <novabank.test.expected-gson>${gson-recent.version}</novabank.test.expected-gson>
                            </systemPropertyVariables>
                            <reportsDirectory>${project.build.directory}/surefire-reports-recents</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
