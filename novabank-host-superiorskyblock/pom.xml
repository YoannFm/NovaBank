<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.novadev.novabank</groupId>
        <artifactId>novabank-parent</artifactId>
        <version>2026.11.23 (1.0.1 #1)</version>
    </parent>

    <artifactId>novabank-host-superiorskyblock</artifactId>
    <name>NovaBank pour SuperiorSkyblock2 (point d'entree)</name>
    <description>Classe du module SuperiorSkyblock2. Le JAR vendu est assemble par novabank-editions.</description>

    <repositories>
        <repository>
            <id>bg-software</id>
            <url>https://repo.bg-software.com/repository/api/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>dev.novadev.novabank</groupId>
            <artifactId>novabank-bukkit</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Annotations de l'API SuperiorSkyblock2 (sinon avertissement, refuse par -Werror). -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2</version>
            <scope>provided</scope>
        </dependency>
        <!-- API de l'hote, depot public (bg-software) ; transitives exclues : seules ses classes servent a compiler. -->
        <dependency>
            <groupId>com.bgsoftware</groupId>
            <artifactId>SuperiorSkyblockAPI</artifactId>
            <version>2026.3</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <!-- JAR intermediaire (classe d'entree seule, sans moteur) : ne pas installer sur un serveur, prendre
             novabank-editions/target/editions/NovaBank-<Hote>-*.jar. -->
        <finalName>${project.artifactId}-interne-${file.version}</finalName>
    </build>
</project>
